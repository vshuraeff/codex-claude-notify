{
  "name": "codex-claude-notify",
  "version": "0.1.0",
  "description": "Forwards Codex turn-complete notifications to the Claude Code session that launched Codex, over its messaging socket.",
  "bin": {
    "codex-claude-notify": "./plugins/codex-claude-notify/hooks/notify.mjs"
  },
  "files": ["plugins/"],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vshuraeff/codex-claude-notify.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/notify.test.mjs test/version.test.mjs",
    "preversion": "npm test",
    "version": "node scripts/sync-version.mjs && git add plugins/codex-claude-notify/.codex-plugin/plugin.json"
  }
}
